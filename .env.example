# Copy to .env and fill in. Never commit .env.

# --- Zetaris (data layer) ---
# REST API of your local Zetaris platform. Create the API key in the Zetaris web UI (localhost:3000).
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=
ZETARIS_ORG_ID=1
# Lightning database HouseCheck registers its REST tables in
ZETARIS_DB=HOUSECHECK_LIVE

# --- Meterless Nightshift (AI provider, NVIDIA Nemotron lanes) ---
# Runtime URL from the Nightshift Console. If HouseCheck runs inside WSL and Nightshift on Windows,
# see README "WSL networking".
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# Leave blank to read it from %LOCALAPPDATA%\ai.meterless.runtime\proxy-token automatically
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto

# --- Modes ---
# live   : Zetaris for all data (fails loudly if Zetaris is down)
# auto   : Zetaris first, recorded samples if Zetaris is unreachable (labelled in the report)
# sample : recorded samples only (no Zetaris, no network) - for demos and tests
HOUSECHECK_DATA_MODE=auto

# 3+ postcodes the Zetaris USL is built over (housecheck usl run)
USL_POSTCODES=
